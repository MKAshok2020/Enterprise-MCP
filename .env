MCP_HOST_APP_NAME=Enterprise MCP Host
# Optional override. Default is in app/config/appsettings.json.
# MCP_HOST_DATABASE_URL=mysql+pymysql://root:root@localhost:3306/enterprise_mcp_host
MCP_HOST_JWT_SECRET=replace-with-a-strong-random-production-secret
MCP_HOST_JWT_ALGORITHM=HS256
MCP_HOST_ACCESS_TOKEN_MINUTES=30
MCP_HOST_REFRESH_TOKEN_MINUTES=480
MCP_HOST_SESSION_TIMEOUT_MINUTES=30
MCP_HOST_MCP_TOOL_TIMEOUT_SECONDS=60
MCP_HOST_WEB_HOST=127.0.0.1
MCP_HOST_WEB_PORT=8000
MCP_HOST_WEB_SESSION_COOKIE_NAME=enterprise_mcp_session
MCP_HOST_WEB_SESSION_COOKIE_SECURE=false
MCP_HOST_AUDIT_IP_PLACEHOLDER=0.0.0.0
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
FACEBOOK_CLIENT_ID=replace-me
FACEBOOK_CLIENT_SECRET=replace-me
ENTERPRISE_SSO_ENTITY_ID=replace-me
ENTERPRISE_SSO_LOGIN_URL=replace-me
