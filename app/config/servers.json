


{
  "servers": [
    {
      "name": "Local Weather REST",
      "description": "Local weather API service for weather, climate, rain, and umbrella questions.",
      "protocol": "rest",
      "enabled": true,
      "connection": {
        "baseUrl": "http://localhost:8009",
        "timeout": 30,
        "verifySSL": true
      },
      "authentication": {
        "type": "none"
      },
      "resilience": {
        "retry": 1,
        "retryDelay": 1
      },
      "operations": {
        "get_weather": {
          "method": "GET",
          "path": "/weather",
          "query": {
            "location": "{location}"
          },
          "properties": {
            "description": "Use this tool when the user asks about weather, climate, temperature, rain, wind, humidity, outdoor conditions, or whether they should carry an umbrella. The LLM must extract the location from the user's request and pass it as the location argument. If the user does not provide a location, ask a follow-up question before calling this tool.",
            "samplePayload": {
              "location": "London"
            },
            "inputSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "location": {
                  "type": "string",
                  "description": "City, town, address, or place name from the user's request, for example London, Chennai, or New York."
                }
              },
              "required": ["location"]
            }
          }
        }
      },
      "allowed_roles": ["Administrator", "Operator"],
      "timeout_seconds": 30
    },
    {
      "name": "JSONPlaceholder REST",
      "description": "Sample JSON REST API service for verifying generic REST tool connectivity.",
      "protocol": "rest",
      "enabled": true,
      "connection": {
        "baseUrl": "https://jsonplaceholder.typicode.com",
        "timeout": 30,
        "verifySSL": true
      },
      "authentication": {
        "type": "none"
      },
      "resilience": {
        "retry": 1,
        "retryDelay": 1
      },
      "operations": {
        "get_post": {
          "method": "GET",
          "path": "/posts/{id}",
          "properties": {
            "description": "Fetch a sample JSONPlaceholder post by id. Use this tool for testing generic JSON REST connectivity.",
            "samplePayload": {
              "id": 1
            },
            "inputSchema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Post id to fetch."
                }
              },
              "required": ["id"]
            }
          }
        }
      },
      "allowed_roles": ["Administrator", "Operator"],
      "timeout_seconds": 30
    },
    {
      "name": "Weather Server",
      "command": "python",
      "args": ["-m", "weather_mcp_server"],
      "env": {},
      "allowed_roles": ["Administrator", "Operator"],
      "timeout_seconds": 30
    },
    {
      "name": "Finance Server",
      "command": "python",
      "args": ["-m", "finance_mcp_server"],
      "env": {},
      "allowed_roles": ["Administrator"],
      "timeout_seconds": 30
    }
  ]
  ,
  "tool_permissions": {
    "Local Weather REST.get_weather": ["Administrator", "Operator"],
    "JSONPlaceholder REST.get_post": ["Administrator", "Operator"],
    "Weather Server.get_forecast": ["Administrator", "Operator"],
    "Finance Server.quote": ["Administrator"],
    "calculator.add": ["Administrator", "Operator"],
    "employee.delete": ["Administrator"]
  },
  "identity_providers": [
    {
      "name": "google",
      "provider_type": "oidc",
      "issuer_url": "https://accounts.google.com",
      "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "userinfo_url": "https://openidconnect.googleapis.com/v1/userinfo",
      "jwks_url": "https://www.googleapis.com/oauth2/v3/certs",
      "metadata_url": "https://accounts.google.com/.well-known/openid-configuration",
      "client_id": "${GOOGLE_CLIENT_ID}",
      "client_secret_ref": "GOOGLE_CLIENT_SECRET",
      "scopes": "openid email profile",
      "default_role": "Viewer",
      "is_active": true
    },
    {
      "name": "microsoft",
      "provider_type": "oidc",
      "issuer_url": "https://login.microsoftonline.com/common/v2.0",
      "authorization_url": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "token_url": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "userinfo_url": "https://graph.microsoft.com/oidc/userinfo",
      "jwks_url": "https://login.microsoftonline.com/common/discovery/v2.0/keys",
      "metadata_url": "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration",
      "client_id": "${MICROSOFT_CLIENT_ID}",
      "client_secret_ref": "MICROSOFT_CLIENT_SECRET",
      "scopes": "openid email profile offline_access",
      "default_role": "Viewer",
      "is_active": true
    },
    {
      "name": "facebook",
      "provider_type": "oauth2",
      "issuer_url": "https://www.facebook.com",
      "authorization_url": "https://www.facebook.com/v19.0/dialog/oauth",
      "token_url": "https://graph.facebook.com/v19.0/oauth/access_token",
      "userinfo_url": "https://graph.facebook.com/me?fields=id,name,email",
      "jwks_url": null,
      "metadata_url": null,
      "client_id": "${FACEBOOK_CLIENT_ID}",
      "client_secret_ref": "FACEBOOK_CLIENT_SECRET",
      "scopes": "email public_profile",
      "default_role": "Viewer",
      "is_active": true
    },
    {
      "name": "enterprise-sso",
      "provider_type": "saml",
      "issuer_url": "${ENTERPRISE_SSO_ENTITY_ID}",
      "authorization_url": "${ENTERPRISE_SSO_LOGIN_URL}",
      "token_url": null,
      "userinfo_url": null,
      "jwks_url": null,
      "metadata_url": "${ENTERPRISE_SSO_METADATA_URL}",
      "client_id": "${ENTERPRISE_SSO_SP_ENTITY_ID}",
      "client_secret_ref": null,
      "scopes": "email profile",
      "default_role": "Viewer",
      "is_active": true
    }
  ]
}
