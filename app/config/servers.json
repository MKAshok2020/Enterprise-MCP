      "userinfo_url": null,
      "jwks_url": null,
      "metadata_url": "${ENTERPRISE_SSO_METADATA_URL}",
      "client_id": "${ENTERPRISE_SSO_SP_ENTITY_ID}",
      "client_secret_ref": null,
      "scopes": "email profile",
      "default_role": "Viewer",
      "is_active": true
    }
