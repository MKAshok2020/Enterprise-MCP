      "client_id": "${GOOGLE_CLIENT_ID}",
      "client_secret_ref": "GOOGLE_CLIENT_SECRET",
      "scopes": "openid email profile",
      "default_role": "Viewer",
      "is_active": true
    },
    {
      "name": "microsoft",
      "provider_type": "oidc",
      "issuer_url": "https://login.microsoftonline.com/common/v2.0",
